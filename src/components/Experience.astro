---
import type { Locale } from "../i18n";
import ui from "../i18n/ui";
import { getResume } from "../i18n/resume";
import Logo from "./Logo.astro";

const locale = Astro.currentLocale as Locale;
const t = ui[locale];
const resume = getResume(locale);
---

<section id="experience" class="mx-auto max-w-5xl px-4 py-24 sm:px-6">
  <h2 class="mb-16 text-center text-3xl font-bold tracking-tight text-neutral-100">
    {t.experience}
  </h2>
  <div class="relative space-y-12">
    <div class="absolute left-[11px] top-2 h-[calc(100%-2rem)] w-px bg-neutral-800 sm:left-[19px]" />
    {resume.experience.map((job, index) => (
      <div class="relative pl-8 sm:pl-12">
        <div class="absolute left-1 top-1.5 h-3.5 w-3.5 rounded-full border-2 border-cyan-400 bg-neutral-950 sm:left-3" />
        <div class="rounded-xl border border-neutral-800 bg-neutral-900/50 p-4 transition hover:border-neutral-700 sm:p-6">
          <div class="mb-1 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-3">
              <Logo logoId={job.logoId} size={32} />
              <h3 class="text-xl font-semibold text-neutral-100">
                {job.title}
              </h3>
            </div>
            <span class="shrink-0 text-sm text-cyan-400">
              {job.startDate} – {job.endDate ?? t.present}
            </span>
          </div>
          <p class="ml-[44px] text-sm font-medium text-neutral-400">
            {job.company}
          </p>
          <div
            class:list={[
              "mt-4 grid gap-6",
              job.media &&
                "md:grid-cols-[minmax(0,3fr)_minmax(16rem,2fr)] md:items-start",
            ]}
          >
            {job.media && (
              <figure class="overflow-hidden rounded-lg border border-neutral-800 bg-neutral-950/80 md:col-start-2 md:row-start-1">
                <div class="aspect-video">
                  {job.media.type === "image" ? (
                    <img
                      src={job.media.src}
                      alt={job.media.alt}
                      width={job.media.width}
                      height={job.media.height}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-contain"
                    />
                  ) : (
                    <video
                      controls
                      playsinline
                      preload="metadata"
                      poster={job.media.poster}
                      aria-label={job.media.label}
                      aria-describedby={`experience-media-${index}`}
                      class="h-full w-full object-contain"
                    >
                      <source src={job.media.src} type="video/mp4" />
                      {job.media.captions && (
                        <track
                          kind="captions"
                          src={job.media.captions.src}
                          srclang={job.media.captions.srcLang}
                          label={job.media.captions.label}
                        />
                      )}
                    </video>
                  )}
                </div>
                {(job.media.caption || job.media.type === "video") && (
                  <figcaption
                    id={`experience-media-${index}`}
                    class="space-y-2 border-t border-neutral-800 px-3 py-2 text-xs leading-relaxed text-neutral-400"
                  >
                    {job.media.caption && <p>{job.media.caption}</p>}
                    {job.media.type === "video" && (
                      <p>{job.media.description}</p>
                    )}
                  </figcaption>
                )}
              </figure>
            )}
            <ul class="space-y-2 md:col-start-1 md:row-start-1">
              {job.descriptions.map((desc) => (
                <li class="flex gap-2 text-sm text-neutral-400">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-neutral-600" />
                  <span>{desc}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
        {job.clientLogos && job.clientLogos.length > 0 && (
          <div class="relative mt-4 overflow-hidden rounded-lg border border-neutral-800 bg-neutral-900/50 px-4 py-3">
            <div class="pointer-events-none absolute inset-y-0 left-0 w-12 bg-gradient-to-r from-neutral-900/80 to-transparent z-10" />
            <div class="pointer-events-none absolute inset-y-0 right-0 w-12 bg-gradient-to-l from-neutral-900/80 to-transparent z-10" />
            <div class="flex animate-marquee items-center gap-4 whitespace-nowrap">
              {[...job.clientLogos, ...job.clientLogos].map((logo) => (
                <button
                  type="button"
                  data-logo
                  data-logo-src={logo.src}
                  data-logo-alt={logo.alt}
                  data-logo-desc={logo.description}
                  data-logo-url={logo.url}
                  class="flex h-12 w-32 shrink-0 cursor-pointer items-center justify-center rounded-lg bg-neutral-800/60 px-3 transition hover:bg-neutral-700/60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
                >
                  <img
                    src={logo.src}
                    alt={logo.alt}
                    height={32}
                    loading="lazy"
                    decoding="async"
                    class="h-8 max-w-full object-contain"
                  />
                </button>
              ))}
            </div>
          </div>
        )}
      </div>
    ))}
  </div>
</section>

<dialog
  id="logo-dialog"
  class="m-auto backdrop:bg-black/80 backdrop:backdrop-blur-sm rounded-xl border border-neutral-800 bg-neutral-900 p-0 text-neutral-100 shadow-2xl max-w-sm w-[calc(100vw-2rem)]"
>
  <div class="relative p-6">
    <button
      type="button"
      id="logo-dialog-close"
      aria-label="Close"
      class="absolute top-3 right-3 rounded-lg p-1.5 text-neutral-400 transition hover:bg-neutral-800 hover:text-neutral-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
    >
      <svg aria-hidden="true" class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <div class="flex flex-col items-center text-center">
      <img id="dialog-logo-img" src="" alt="" class="h-16 w-auto object-contain" />
      <h3 id="dialog-logo-name" class="mt-4 text-lg font-semibold"></h3>
      <p id="dialog-logo-desc" class="mt-2 text-sm leading-relaxed text-neutral-400"></p>
      <a
        id="dialog-logo-link"
        href=""
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex items-center gap-2 rounded-full border border-cyan-500/30 bg-cyan-500/10 px-4 py-2 text-sm font-medium text-cyan-400 transition hover:bg-cyan-500/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
      >
        Visitar site
        <span class="sr-only">(abre em nova aba)</span>
        <svg aria-hidden="true" class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById("logo-dialog") as HTMLDialogElement;
  const img = document.getElementById("dialog-logo-img") as HTMLImageElement;
  const name = document.getElementById("dialog-logo-name") as HTMLElement;
  const desc = document.getElementById("dialog-logo-desc") as HTMLElement;
  const link = document.getElementById("dialog-logo-link") as HTMLAnchorElement;
  const closeBtn = document.getElementById("logo-dialog-close") as HTMLButtonElement;

  document.querySelectorAll("[data-logo]").forEach((btn) => {
    btn.addEventListener("click", () => {
      img.src = btn.getAttribute("data-logo-src")!;
      img.alt = btn.getAttribute("data-logo-alt")!;
      name.textContent = btn.getAttribute("data-logo-alt")!;
      desc.textContent = btn.getAttribute("data-logo-desc")!;
      link.href = btn.getAttribute("data-logo-url")!;
      dialog.showModal();
    });
  });

  closeBtn?.addEventListener("click", () => dialog.close());

  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>
