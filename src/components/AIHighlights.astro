---
import { resume } from "../data/resume";
import Logo from "./Logo.astro";
---

<section
  id="ai-innovation"
  class="relative mx-auto max-w-5xl overflow-hidden px-6 py-24"
>
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_30%_50%,_rgba(168,85,247,0.06)_0%,_transparent_50%),_radial-gradient(ellipse_at_70%_50%,_rgba(6,182,212,0.06)_0%,_transparent_50%)]"
  />
  <svg
    class="pointer-events-none absolute inset-0 -z-10 h-full w-full opacity-[0.04]"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <pattern id="neural-grid" x="0" y="0" width="60" height="60" patternUnits="userSpaceOnUse">
        <circle cx="30" cy="30" r="1.5" fill="white" />
        <line x1="30" y1="30" x2="90" y2="30" stroke="white" stroke-width="0.5" />
        <line x1="30" y1="30" x2="30" y2="90" stroke="white" stroke-width="0.5" />
        <line x1="30" y1="30" x2="90" y2="90" stroke="white" stroke-width="0.3" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#neural-grid)" />
  </svg>

  <div class="relative">
    <div class="mb-4 flex items-center justify-center gap-3">
      <span
        class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-violet-500 to-cyan-500 text-lg"
      >
        <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" />
        </svg>
      </span>
      <h2 class="text-center text-3xl font-bold tracking-tight text-neutral-100">
        AI & Innovation
      </h2>
    </div>
    <p class="mb-12 text-center text-neutral-400">
      Driving AI adoption across the frontend chapter — from pair programming to
      infrastructure intelligence
    </p>

    <div class="mx-auto grid max-w-4xl gap-6 sm:grid-cols-3">
      {resume.aiTools.map((tool) => (
        <div class="group relative rounded-xl border border-neutral-800 bg-neutral-900/60 p-6 text-center transition hover:border-violet-500/50 hover:bg-neutral-900/80">
          <div class="mb-4 flex justify-center">
            <Logo logoId={tool.logoId} size={48} />
          </div>
          <h3 class="mb-2 text-lg font-semibold text-neutral-100">
            {tool.name}
          </h3>
          <p class="text-sm leading-relaxed text-neutral-400">
            {tool.description}
          </p>
        </div>
      ))}
    </div>

    <div class="mt-12 text-center">
      <div class="inline-flex items-center gap-3 rounded-full border border-cyan-500/20 bg-cyan-500/5 px-6 py-3">
        <svg class="h-5 w-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342" />
        </svg>
        <span class="text-sm text-cyan-300">
          MBA in Artificial Intelligence Applied to Business Management —
          Fundação Dom Cabral
        </span>
      </div>
    </div>
  </div>
</section>
