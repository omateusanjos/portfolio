---
import socialCard from "../assets/social-card.png";
import "../styles/global.css";
import type { Locale } from "../i18n";
import { langAttr } from "../i18n";
import ui from "../i18n/ui";
import { getResume } from "../i18n/resume";
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props {
  locale: Locale;
  title: string;
}

const { locale, title } = Astro.props;
const lang = langAttr[locale];
const t = ui[locale];
const resume = getResume(locale);

const otherLocale = locale === "en" ? "pt-br" : "en";
const selfUrl = getRelativeLocaleUrl(locale, Astro.url.pathname);
const altUrl = getRelativeLocaleUrl(otherLocale, Astro.url.pathname);
const siteUrl = new URL("/", Astro.site ?? Astro.url);
const socialCardUrl = new URL(socialCard.src, siteUrl);
const markdownResumeUrl = getRelativeLocaleUrl(locale, "resume.md");
const jsonResumeUrl = getRelativeLocaleUrl(locale, "resume.json");

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${selfUrl}#profile`,
  url: selfUrl,
  name: title,
  description: t.meta.description,
  mainEntity: {
    "@type": "Person",
    "@id": `${siteUrl}#person`,
    name: resume.name,
    jobTitle: resume.title,
    url: siteUrl,
    email: resume.email,
    sameAs: [`https://${resume.linkedin}`],
    address: {
      "@type": "PostalAddress",
      addressLocality: "São Paulo",
      addressCountry: "BR",
    },
    knowsAbout: resume.skills.flatMap(({ items }) => items),
    knowsLanguage: resume.languages.map(({ language }) => language),
    alumniOf: resume.education.map(({ institution }) => ({
      "@type": "EducationalOrganization",
      name: institution,
    })),
    hasCredential: resume.certifications.map((certification) => ({
      "@type": "EducationalOccupationalCredential",
      name: certification,
    })),
    worksFor: {
      "@type": "Organization",
      name: resume.experience[0].company,
    },
    hasOccupation: {
      "@type": "Occupation",
      name: resume.title,
      occupationLocation: {
        "@type": "City",
        name: "São Paulo",
      },
      skills: resume.skills.flatMap(({ items }) => items).join(", "),
    },
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={selfUrl} />
    <link rel="alternate" hreflang={lang} href={selfUrl} />
    <link rel="alternate" hreflang={langAttr[otherLocale]} href={altUrl} />
    <link rel="alternate" hreflang="x-default" href={getRelativeLocaleUrl("en", Astro.url.pathname)} />
    <link rel="alternate" type="text/markdown" href={markdownResumeUrl} title="Mateus Anjos resume in Markdown" />
    <link rel="alternate" type="application/json" href={jsonResumeUrl} title="Mateus Anjos resume in JSON" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={t.meta.description} />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>

    <meta property="og:locale" content={locale === "en" ? "en_US" : "pt_BR"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={selfUrl} />
    <meta property="og:image" content={socialCardUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialCardUrl} />
    <meta name="twitter:image:alt" content={t.meta.ogAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a
      href="#main-content"
      class="fixed top-4 left-4 z-[100] -translate-y-20 rounded-lg bg-cyan-400 px-4 py-2 text-sm font-semibold text-neutral-950 transition focus:translate-y-0 focus:outline-2 focus:outline-offset-2 focus:outline-white"
    >
      {t.skip}
    </a>
    <slot />
    <script>
      import { inject } from "@vercel/analytics";
      inject();
    </script>
  </body>
</html>
