---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { LOGOS, initialsSvg } from "../data/logos";

import aarinLogo from "../assets/companies/logo-aarin.jpeg";
import jussiLogo from "../assets/companies/logo-jussi.jpeg";
import receitadigitalLogo from "../assets/companies/logo-receitadigital.jpeg";
import briterisLogo from "../assets/companies/logo-briteris.jpg";
import shiftLogo from "../assets/companies/logo-shiftinc.png";

const imageLogos: Record<string, ImageMetadata> = {
  aarin: aarinLogo,
  whirlpool: jussiLogo,
  mevo: receitadigitalLogo,
  "iteris-briteris": briterisLogo,
  shift: shiftLogo,
};

export interface Props {
  logoId: string;
  size?: number;
}

const { logoId, size = 36 } = Astro.props;
const image = imageLogos[logoId];
const logo = LOGOS[logoId];
---

{
  image ? (
    <Image
      src={image}
      alt=""
      width={size}
      height={size}
      densities={[1, 2]}
      format="webp"
      quality={85}
      loading="lazy"
      decoding="async"
      class="shrink-0 rounded-md border border-neutral-800 object-cover"
    />
  ) : logo ? (
    <div
      class="shrink-0 overflow-hidden"
      style={`width: ${size}px; height: ${size}px;`}
      set:html={initialsSvg(logo.initials, logo.bgColor, size)}
    />
  ) : null
}
