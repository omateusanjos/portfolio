---
import { resume } from "../data/resume";
---

<section
  id="engineering-foundations"
  aria-labelledby="engineering-foundations-title"
  class="relative mx-auto max-w-5xl px-4 py-24 sm:px-6"
>
  <div class="pointer-events-none absolute inset-x-6 top-1/2 -z-10 h-72 -translate-y-1/2 bg-[radial-gradient(ellipse_at_center,_rgba(6,182,212,0.06),_transparent_68%)]" />

  <header class="mb-12 grid gap-5 md:grid-cols-[minmax(0,0.8fr)_minmax(20rem,1.2fr)] md:items-end">
    <div>
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-cyan-400">
        Systems that compound
      </p>
      <h2
        id="engineering-foundations-title"
        class="text-3xl font-bold tracking-tight text-neutral-100"
      >
        Engineering Foundations
      </h2>
    </div>
    <p class="max-w-2xl text-sm leading-relaxed text-neutral-400 md:justify-self-end md:text-base">
      Private platforms, libraries, and standards I built to turn recurring
      frontend problems into reusable, company-wide capabilities.
    </p>
  </header>

  <ol class="grid gap-6 md:grid-cols-2">
    {resume.engineeringFoundations.map((foundation, index) => (
      <li>
        <article class="group relative flex h-full flex-col overflow-hidden rounded-xl border border-neutral-800 bg-neutral-900/50 p-5 transition hover:border-cyan-500/30 hover:bg-neutral-900/70 sm:p-6">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-cyan-400/0 to-transparent transition group-hover:via-cyan-400/60" />

          <header class="mb-5 flex items-center justify-between gap-4">
            <span class="text-xs font-semibold uppercase tracking-wider text-cyan-400">
              {foundation.category}
            </span>
            <span class="font-mono text-xs text-neutral-600" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
          </header>

          <h3 class="mb-3 text-xl font-semibold tracking-tight text-neutral-100">
            {foundation.title}
          </h3>
          <p class="text-sm leading-relaxed text-neutral-400">
            {foundation.summary}
          </p>

          <dl class="my-6 grid grid-cols-2 gap-3 border-y border-neutral-800 py-4">
            {foundation.metrics.map((metric) => (
              <div class="min-w-0">
                <dt class="text-base font-semibold leading-tight text-cyan-300 sm:text-lg">
                  {metric.value}
                </dt>
                <dd class="mt-1 text-xs leading-relaxed text-neutral-400">
                  {metric.label}
                </dd>
              </div>
            ))}
          </dl>

          <ul class="mt-auto space-y-3">
            {foundation.outcomes.map((outcome) => (
              <li class="flex gap-3 text-sm leading-relaxed text-neutral-400">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-cyan-500/70" />
                <span>{outcome}</span>
              </li>
            ))}
          </ul>
        </article>
      </li>
    ))}
  </ol>
</section>
