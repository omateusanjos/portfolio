---
import { resume } from "../data/resume";
import Logo from "./Logo.astro";
---

<section id="experience" class="mx-auto max-w-5xl px-6 py-24">
  <h2 class="mb-16 text-center text-3xl font-bold tracking-tight text-neutral-100">
    Experience
  </h2>
  <div class="relative space-y-12">
    <div class="absolute left-[19px] top-2 h-[calc(100%-2rem)] w-px bg-neutral-800" />
    {resume.experience.map((job) => (
      <div class="relative pl-12">
        <div class="absolute left-2.5 top-1.5 h-3.5 w-3.5 rounded-full border-2 border-cyan-400 bg-neutral-950" />
        <div class="rounded-xl border border-neutral-800 bg-neutral-900/50 p-6 transition hover:border-neutral-700">
          <div class="mb-1 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-3">
              <Logo logoId={job.logoId} size={32} />
              <h3 class="text-xl font-semibold text-neutral-100">
                {job.title}
              </h3>
            </div>
            <span class="shrink-0 text-sm text-cyan-400">{job.period}</span>
          </div>
          <p class="mb-4 ml-[44px] text-sm font-medium text-neutral-500">
            {job.company}
          </p>
          <ul class="space-y-2">
            {job.descriptions.map((desc) => (
              <li class="flex gap-2 text-sm text-neutral-400">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-neutral-600" />
                <span>{desc}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>
</section>
