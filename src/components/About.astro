---
import type { Locale } from "../i18n";
import ui from "../i18n/ui";
import { getResume } from "../i18n/resume";

const locale = Astro.currentLocale as Locale;
const t = ui[locale];
const resume = getResume(locale);
---

<section id="about" class="mx-auto max-w-5xl px-6 py-24">
  <h2 class="mb-12 text-center text-3xl font-bold tracking-tight text-neutral-100">
    {t.about}
  </h2>
  <div class="mx-auto max-w-3xl space-y-5 text-lg leading-relaxed text-neutral-400">
    {resume.summary.split("\n\n").map((paragraph) => (
      <p>{paragraph}</p>
    ))}
  </div>
</section>
