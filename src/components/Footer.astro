---
import type { Locale } from "../i18n";
import ui from "../i18n/ui";
import { getResume } from "../i18n/resume";
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = Astro.currentLocale as Locale;
const t = ui[locale];
const resume = getResume(locale);
const resumeMdUrl = locale === "en" ? "/resume.md" : "/pt-br/resume.md";
---

<footer id="contact" class="border-t border-neutral-800">
  <div class="mx-auto max-w-5xl px-4 py-20 text-center sm:px-6">
    <h2 class="mb-4 text-3xl font-bold tracking-tight text-neutral-100">
      {t.footer.title}
    </h2>
    <p class="mb-10 text-neutral-400">
      {t.footer.intro}
    </p>
    <div class="flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-6">
      <a
        href={`mailto:${resume.email}`}
        class="inline-flex max-w-full items-center gap-2 rounded-full border border-neutral-700 bg-neutral-900 px-5 py-3 text-sm font-medium text-neutral-100 transition hover:border-cyan-500 hover:bg-cyan-500/10 hover:text-cyan-400 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-400 sm:px-6"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span class="break-all sm:break-normal">{resume.email}</span>
      </a>
      <a
        href={`https://${resume.linkedin}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full border border-neutral-700 bg-neutral-900 px-6 py-3 text-sm font-medium text-neutral-100 transition hover:border-cyan-500 hover:bg-cyan-500/10 hover:text-cyan-400 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-400"
      >
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
        </svg>
        LinkedIn
      </a>
    </div>
    <p class="mt-6 text-sm">
      <a href={resumeMdUrl} class="text-neutral-400 transition hover:text-cyan-400 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-400">
        {t.footer.md}
      </a>
    </p>
    <ul class="mt-10 flex flex-wrap items-center justify-center gap-3 text-sm text-neutral-400">
      {resume.languages.map((lang) => (
        <li class="flex items-center gap-3 before:text-neutral-600 before:content-['·'] first:before:hidden">
          <span>{lang.language} — {lang.level}</span>
        </li>
      ))}
    </ul>
    <p class="mt-8 text-sm text-neutral-400">
      &copy; {new Date().getFullYear()} {resume.name}. {t.footer.rights}
    </p>
  </div>
</footer>
